# -----------------------------------------------------------------------------
# Luxelineage — copy to `.env` and fill in real values. Never commit `.env`.
# -----------------------------------------------------------------------------

# PostgreSQL (required). Supabase: use pooled URL for DATABASE_URL when using PgBouncer.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true&connection_limit=1"
# Direct connection for migrations / prisma migrate (non-pooler host if applicable).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase — project URL (browser + server).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# Client key: use anon JWT OR Supabase "publishable" key (see dashboard API settings).
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# If your project uses the newer naming only:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Server-only: service role (never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=""
# Legacy alternate name supported by code:
# SUPABASE_SECRET_KEY=""

# API CORS: comma-separated origins allowed to call browser-exposed APIs from another domain.
# Include your production site and admin URL if applicable.
CORS_ALLOW_ORIGINS="http://localhost:3000"

# Optional: enables POST /api/auth/signup for creating admins when header/body secret matches.
ADMIN_BOOTSTRAP_SECRET=""

# Optional: scripts/seed-admin-supabase.ts
# SUPABASE_ADMIN_UID=""
# ADMIN_EMAIL=""
